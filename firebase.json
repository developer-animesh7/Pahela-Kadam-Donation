{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      ".git/**",
      "js/github-config.js",
      "cloudflare-worker/**",
      "run_website.sh",
      "run_website.bat",
      "README.md",
      "SCALING_GUIDE.md",
      "google-apps-script.gs"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif|svg|ico|avif)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000" }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/pages/landing.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/pages/landing",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/pages/landing/",
        "destination": "/",
        "type": 301
      },
      {
